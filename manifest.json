{
  "manifest_version": 3,
  "name": "find my accounts",
  "version": "1.0.0",
  "description": "Scan uploaded email files to discover accounts associated with your email",
  
  "permissions": [],
  
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },

  "action": {
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png"
    },
    "default_popup": "src/popup/popup.html"
  }
}

