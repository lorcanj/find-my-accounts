{
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.27.2",
    "javascript-obfuscator": "^5.1.0",
    "jsdom": "^27.4.0",
    "vitest": "4.0.16"
  },
  "dependencies": {
    "email-addresses": "^3.1.0",
    "emailjs-mime-parser": "^2.0.7",
    "tldts": "^7.0.19"
  },
  "scripts": {
    "test": "vitest --run",
    "build": "esbuild mboxParser.worker=src/scanners/mbox/mboxParser.worker.js popup=src/popup/popup.js --bundle --drop:console --outdir=dist-raw --platform=browser --format=esm && npm run obfuscate",
    "build:dev": "esbuild mboxParser.worker=src/scanners/mbox/mboxParser.worker.js popup=src/popup/popup.js --bundle --sourcemap --outdir=dist --platform=browser --format=esm",
    "obfuscate": "javascript-obfuscator dist-raw --output dist --config obfuscator.config.json",
    "bundle:emailjs": "esbuild node_modules/emailjs-mime-parser/dist/mimeparser.js --bundle --outfile=src/vendors/emailjs-mime-parser.bundle.js --platform=browser --format=esm",
    "build:watch": "esbuild mboxParser.worker=src/scanners/mbox/mboxParser.worker.js popup=src/popup/popup.js --bundle --outdir=dist --platform=browser --format=esm --watch"
  }
}
