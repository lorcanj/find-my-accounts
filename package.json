{
  "name": "find-my-accounts",
  "type": "module",
  "devDependencies": {
    "archiver": "^6.0.2",
    "esbuild": "^0.27.2",
    "jsdom": "^27.4.0",
    "vitest": "4.1.11",
    "web-ext": "^10.3.0"
  },
  "dependencies": {
    "email-addresses": "^5.0.0",
    "emailjs-mime-parser": "^2.0.7",
    "tldts": "^7.0.19"
  },
  "scripts": {
    "test": "vitest --run",
    "build": "rm -rf dist && esbuild mboxParser.worker=src/scanners/mbox/mboxParser.worker.js popup=src/popup/popup.js --bundle --drop:console --minify --outdir=dist --platform=browser --format=esm",
    "build:dev": "esbuild mboxParser.worker=src/scanners/mbox/mboxParser.worker.js popup=src/popup/popup.js --bundle --sourcemap --outdir=dist --platform=browser --format=esm",
    "bundle:emailjs": "esbuild node_modules/emailjs-mime-parser/src/mimeparser.js --bundle --outfile=src/vendors/emailjs-mime-parser.bundle.js --platform=browser --format=esm --alias:ramda=./src/vendors/ramda-shim.js",
    "build:watch": "esbuild mboxParser.worker=src/scanners/mbox/mboxParser.worker.js popup=src/popup/popup.js --bundle --outdir=dist --platform=browser --format=esm --watch",
    "release": "npm run build && node scripts/create-release.js",
    "start": "web-ext run",
    "bench": "esbuild scripts/perf.js --bundle --platform=node --format=esm --outfile=dist/perf.bundle.js && node dist/perf.bundle.js"
  }
}
